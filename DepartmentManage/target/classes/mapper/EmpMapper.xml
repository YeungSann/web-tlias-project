<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaweb.departmentmanage.mapper.EmpMapper">



    <!--    変更前：
    <select id="list2" resultType="com.javaweb.departmentmanage.pojo.Emp">
        select e.* ,d.name deptName from emp e left join dept d on e.dept_id = d.id
        where
            % は SQL におけるワイルドカード文字であるためエスケープしないと認識エラーが発生します。
            以下のように記述するとプレースホルダー ? が引用符 ' ' の中に配置され、? が無効化されます。
            e.name like '%#{name}%'
            and e.gender = #{gender}
            and e.entry_date between #{begin} and #{end}
        order by e.update_time desc
    </select>  -->

    <!--    注意：id 属性は EmpMapper.java 内のメソッド名と完全一致させる必要があります。一致しない場合エラーが発生します！-->
    <!--
    <select id="list2" resultType="com.javaweb.departmentmanage.pojo.Emp">
        select e.* ,d.name deptName from emp e left join dept d on e.dept_id = d.id
        where
         ここでは % が SQL のワイルドカードとして解釈され検索が失敗するのを防ぐため、文字列結合（concat）を使用しています
        e.name like concat('%', #{name}, '%')
        and e.gender = #{gender}
        and e.entry_date between #{begin} and #{end}
        order by e.update_time desc
    </select>  -->


    <select id="list3" resultType="com.javaweb.departmentmanage.pojo.Emp">
        select e.* ,d.name deptName from emp e left join dept d on e.dept_id = d.id
        <where>
            <!--  ここでは % が SQL のワイルドカードとして解釈され検索が失敗するのを防ぐため、文字列結合（concat）を使用しています -->
            <!-- 動的 SQL ステートメントを記述して条件検索を実行 -->
            <if test="name != null and name != ''">
                e.name like concat('%', #{name}, '%')
            </if>
            <if test="gender != null and gender != ''">
                and e.gender = #{gender}
            </if>
            <if test="begin != null and end != null">
                and e.entry_date between #{begin} and #{end}
            </if>
        </where>
        order by e.update_time desc

    </select>

    <!--    社員基本情報の削除：動的 SQL ステートメントを使用し、ID に基づき社員情報を一括削除 -->
    <delete id="deleteByIds">
        <!--  delete from emp where id in (1,2,3) 動的 SQL による一括削除  -->
        delete from emp where id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </delete>

    <!--  外部結合（LEFT JOIN）を使用して社員基本情報および職歴情報を取得  -->
    <!--    手動結果マッピング：以下の resultMap タグを使用してマッピングを実施  -->
    <select id="selectById" resultMap="empResultMap">
        select e.* ,
        ex.id exId,
        ex.begin exBegin,
        ex.end exEnd,
        ex.company exCompany,
        ex.job exJob
        from emp e left join emp_expr ex on e.id = ex.emp_id
        where e.id = #{id}
    </select>

    <!--  上記クエリに対する手動結果マッピングの設定：resultMap タグを使用して設定  -->
    <resultMap id="empResultMap" type="com.javaweb.departmentmanage.pojo.Emp">
        <id column="id" property="id" />
        <!--    前方がテーブルの列（カラム）名、後方が POJO のプロパティ名（マッピング用）    -->
        <!--    通常のプロパティは result タグを使用してマッピング    -->
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="name" property="name" />
        <result column="gender" property="gender" />
        <result column="image" property="image" />
        <result column="entry_date" property="entryDate" />
        <result column="dept_id" property="deptId" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="phone" property="phone" />
        <result column="job" property="job" />
        <result column="salary" property="salary" />
        <!--    職歴情報のマッピング    -->
        <!--    collection タグは集合（リスト等）オブジェクトのマッピングに使用し、ofType 属性で要素の型を指定 -->
        <collection property="exprList" ofType="com.javaweb.departmentmanage.pojo.EmpExpr">
            <id column="exId" property="id" />
            <!-- 親テーブルの id を子テーブルの empId として直接再利用（EmpExpr クラスに empId プロパティが存在する場合） -->
            <result column="id" property="empId" />
            <result column="exBegin" property="begin" />
            <result column="exEnd" property="end" />
            <result column="exJob" property="job" />
            <result column="exCompany" property="company" />
        </collection>

    </resultMap>

    <!-- 動的 SQL ステートメントを使用して社員基本情報を更新 -->
    <update id="updateById">
        update emp
        <!--   set タグは末尾の不要なカンマを自動的に削除します   -->
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="name != null and name != ''">
                name = #{name},
            </if>
            <if test="gender != null">
                gender = #{gender},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <!--   Integer 型は空文字 '' になることがないため、ここでの空文字判定は不要です   -->
            <if test="job != null">
                job = #{job},
            </if>
            <if test="salary != null">
                salary = #{salary},
            </if>
            <if test="image != null and image != ''">
                image = #{image},
            </if>
            <if test="entryDate != null">
                entry_date = #{entryDate},
            </if>
            <!--   Integer 型は空文字 '' になることがないため、ここでの空文字判定は不要です   -->
            <if test="deptId != null">
                dept_id = #{deptId},
            </if>
            <if test="updateTime != null">
                update_time = #{updateTime},
            </if>
        </set>

        where id = #{id}
    </update>

    <!-- パスワード変更：IDに基づいてパスワードを更新 -->
    <update id="updatePassword">
        update emp
        set password = #{password}, update_time = now()
        where id = #{id}
    </update>


    <!-- 社員情報の集計・統計 -->
    <!-- 社員役職統計 -->
    <!-- position や quantity フィールドを持つエンティティテーブルが存在しないため、ここでは resultMap による手動マッピングを行わず Map への自動マッピングを直接使用しています。
     手動での resultMap マッピングが必要となるケース：
     1対多や1対1などの複雑な結合クエリ、または取得カラム名と POJO プロパティ名が大きく異なる場合 -->
    <select id="countJobData" resultType="map">
        select
        (case
        when job = 1 then '担任'
        when job = 2 then '講師'
        when job = 3 then '学生課チーフ'
        when job = 4 then '教研マネージャー'
        when job = 5 then 'カウンセラー'
        else 'その他' end ) position,
        count(*)  quantity
        from emp group by job
        order by quantity
    </select>

    <!-- 社員性別統計 -->
    <select id="countGenderData" resultType="map">
        select
        <!--   CASE WHEN 文のほか、IF 関数を使用してフロー制御を行うことも可能です  -->
        if(gender = 1 ,'男性社員','女性社員') name,
        <!--  注意：ECharts の円グラフ（パイチャープ）では、キー名が 'name' であることが厳格に求められます   -->
        count(*) value
        from emp group by gender
    </select>

</mapper>