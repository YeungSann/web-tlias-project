<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaweb.departmentmanage.mapper.EmpExprMapper">
    <!-- 社員職歴情報の一括登録（バッチ挿入） -->
    <insert id="saveBatchExpr" >
        insert into emp_expr (emp_id,begin,end,company,job) values
        <!--   collection属性：反復処理（ループ）対象のコレクションオブジェクトを指定
             item：コレクションから取り出された各要素の変数名
             separator：各要素間に挿入する区切り文字
              open：反復処理開始時に出力する文字（開始括弧）
               close：反復処理終了時に出力する文字（終了括弧） -->
        <foreach collection="exprList" item="expr" separator=",">
            (#{expr.empId},#{expr.begin},#{expr.end},#{expr.company},#{expr.job})
        </foreach>
    </insert>

    <!--  delete from emp_expr where emp_id in (1,2,3) 動的SQLによる一括削除  -->
    <delete id="deleteByEmpIds">
        delete from emp_expr where emp_id in
        <!--   empIdsコレクションを反復処理し、各要素をカンマ区切りの文字列に変換 -->
        <!--    emp_expr テーブルの主キー（id）ではなく emp_id フィールドを使用して社員職歴情報を削除します。
            emp_id フィールドは emp テーブルの id フィールドに対する論理外鍵関係となっているため、emp_id を直接指定して関連する職歴情報を一括削除可能です。 -->
        <foreach collection="empIds" item="empId" open="(" close=")" separator=",">
            #{empId}
        </foreach>
    </delete>
</mapper>