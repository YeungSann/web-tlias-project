<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.javaweb.departmentmanage.mapper.ClazzMapper">

    <!--   検索条件付きページング照会 -->
    <select id="findPage" resultType="com.javaweb.departmentmanage.pojo.Clazz">
        select c.*, e.name as masterName from clazz c left join emp e on c.master_id = e.id
        <where>
            <if test="queryParam.name != null and queryParam.name != ''">
                c.name like concat('%', #{queryParam.name}, '%')
            </if>
            <if test="queryParam.begin != null and queryParam.end != null">
                and c.begin_date between #{queryParam.begin} and #{queryParam.end}
            </if>
        </where>
        order by c.update_time desc
        limit #{start}, #{pageSize}
    </select>
    <!-- 条件に一致するクラスの総件数を取得（ページング計算用） -->
    <select id="findAll" resultType="java.lang.Long">
        select count(*) from clazz c left join emp e on c.master_id = e.id
        <where>
            <if test="queryParam.name != null and queryParam.name != ''">
                c.name like concat('%', #{queryParam.name}, '%')
            </if>
            <if test="queryParam.begin != null and queryParam.end != null">
                and c.begin_date between #{queryParam.begin} and #{queryParam.end}
            </if>
        </where>
    </select>

    <!-- 動的SQLによるクラス情報の更新（非null項目のみ更新） -->
    <update id="updateClazz">
        update clazz
        <set>
            <if test="name != null and name != ''">
                name=#{name},
            </if>
            <if test="room != null and room != ''">
                room=#{room},
            </if>
            <if test="beginDate != null ">
                begin_date=#{beginDate},
            </if>
            <if test="endDate != null ">
                end_date=#{endDate},
            </if>
            <if test="masterId != null ">
                master_id=#{masterId},
            </if>
            <if test="subject != null ">
                subject=#{subject},
            </if>
            <if test="createTime != null ">
                create_time=#{createTime},
            </if>
            <if test="updateTime != null ">
                update_time=#{updateTime},
            </if>
        </set>
        where id=#{id}
    </update>
</mapper>