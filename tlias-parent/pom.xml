<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 声明父工程是springboot工程 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <!--                这里用来配置父工程的pom文件的相对路径
                        不写的话，会从maven仓库中查找父工程的pom文件 -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.tlias</groupId>
    <artifactId>tlias-parent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- 父工程的打包方式为pom，不写代码，只进行依赖管理 -->
    <packaging>pom</packaging>

    <!-- 聚合工程 -->
    <modules>
        <module>../tlias-utils</module>
        <module>../DepartmentManage</module>
        <module>../tlias-pojo</module>
    </modules>

<!-- 依赖管理   强制所有子工程都必须继承的依赖 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 引入springboot核心包依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <!--   spring boot版本号不需要指定，直接由pom.xml的bom管理-->
        </dependency>

    </dependencies>

<!-- 依赖管理   子工程可以根据需要引入，也可以不引入  父工程只管理版本号-->
    <dependencyManagement>
        <dependencies>
            <!-- Web 依赖，版本受父工程 spring-boot-dependencies (4.0.7) 管控 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring.boot.starter.web.version}</version>
            </dependency>

            <!-- 导入jwt依赖 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jjwt.version}</version>
                <scope>compile</scope>
            </dependency>

            <!-- 导入阿里云OSS依赖 -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.sdk.oss.version}</version>
            </dependency>

            <!--  为了使用阿里云，继续引入jaxb依赖 -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb.api.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.activation</groupId>
                <artifactId>activation</artifactId>
                <version>${activation.version}</version>
            </dependency>
            <!-- no more than 2.3.3-->
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb.runtime.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

<!-- 统一管理版本号 -->
        <jjwt.version>0.12.6</jjwt.version>
        <spring.boot.starter.version>4.0.7</spring.boot.starter.version>
        <lombok.version>1.18.46</lombok.version>
        <spring.boot.starter.web.version>4.0.7</spring.boot.starter.web.version>
        <aliyun.sdk.oss.version>3.18.4</aliyun.sdk.oss.version>
        <jaxb.api.version>2.3.1</jaxb.api.version>
        <activation.version>1.1.1</activation.version>
        <jaxb.runtime.version>2.3.3</jaxb.runtime.version>
    </properties>

