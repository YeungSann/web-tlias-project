<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 親プロジェクトが Spring Boot プロジェクトであることを宣言 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <!--                ここは親プロジェクトの pom ファイルの相対パスを設定する場所
                        設定しない場合、Maven リポジトリから親プロジェクトの pom ファイルを検索する -->
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.tlias</groupId>
    <artifactId>tlias-parent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- 親プロジェクトのパッケージング方式は pom。コードは記述せず、依存関係管理のみを行う -->
    <packaging>pom</packaging>

    <!-- マルチモジュール（集約）プロジェクト -->
    <modules>
        <module>../tlias-utils</module>
        <module>../DepartmentManage</module>
        <module>../tlias-pojo</module>
    </modules>

    <!-- 依存関係管理：すべての子プロジェクトで継承が必須となる依存関係 -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot コアパッケージ依存関係を導入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <!--   Spring Boot のバージョン指定は不要。pom.xml の BOM によって直接管理される -->
        </dependency>

    </dependencies>

    <!-- 依存関係管理：子プロジェクトが必要に応じて導入・非導入を選択可能（親プロジェクトはバージョン番号のみを管理） -->
    <dependencyManagement>
        <dependencies>
            <!-- Web 依存関係（バージョンは親プロジェクトの spring-boot-dependencies (4.0.7) により管理） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-web</artifactId>
                <version>${spring.boot.starter.web.version}</version>
            </dependency>

            <!-- JWT 依存関係を導入 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt</artifactId>
                <version>${jjwt.version}</version>
                <scope>compile</scope>
            </dependency>

            <!-- アリババクラウド OSS 依存関係を導入 -->
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>${aliyun.sdk.oss.version}</version>
            </dependency>

            <!--  アリババクラウド利用のため、引き続き JAXB 依存関係を導入 -->
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb.api.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.activation</groupId>
                <artifactId>activation</artifactId>
                <version>${activation.version}</version>
            </dependency>
            <!-- 2.3.3 以下であること -->
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb.runtime.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- バージョン番号の一括管理 -->
        <jjwt.version>0.12.6</jjwt.version>
        <spring.boot.starter.version>4.0.7</spring.boot.starter.version>
        <lombok.version>1.18.46</lombok.version>
        <spring.boot.starter.web.version>4.0.7</spring.boot.starter.web.version>
        <aliyun.sdk.oss.version>3.18.4</aliyun.sdk.oss.version>
        <jaxb.api.version>2.3.1</jaxb.api.version>
        <activation.version>1.1.1</activation.version>
        <jaxb.runtime.version>2.3.3</jaxb.runtime.version>
    </properties>

    <!--  プライベートリポジトリ（NEXUS等）のアドレスを設定 -->
    <!--
